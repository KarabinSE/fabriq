<?php

use Illuminate\Support\Facades\Route;
use Karabin\FabriqPlugin\Http\Controllers\MenuController;
use Karabin\FabriqPlugin\Http\Controllers\NewsController;
use Karabin\FabriqPlugin\Http\Controllers\PageController;

Route::middleware('locale')->group(function () {
    // Pages
    Route::get('pages/{slug}', [PageController::class, 'show'])->name('pages.show');

    // Menus
    Route::get('menus/{slug}', [MenuController::class, 'show'])->name('menus.show');

    // news
    Route::get('news', [NewsController::class, 'index'])->name('news.index');
    Route::get('news/{slug}', [NewsController::class, 'show'])->name('news.show');
});
