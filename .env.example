APP_NAME='Fabriq CMS'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=homestead
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

## 1password - search for htalel6yrgvkruesxthu4sctbi
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=fabriq-cms
AWS_USE_PATH_STYLE_ENDPOINT=false
BUCKET_PREFIX=fabriq-dev
AWS_URL='https://media.fabriq.se'

MEDIA_DISK=public

VITE_APP_NAME="${APP_NAME}"

# Fabriq
FABRIQ_FRONT_END_DOMAIN=http://localhost:3000

# Webhooks
FABRIQ_WEBHOOK_ENABLED=false
FABRIQ_WEBHOOK_SECRET=secret
FABRIQ_WEBHOOK_ENDPOINT="https://your-front-end-domain/api/webhooks"

# Ffmpeg
#FFPROBE_PATH=/usr/bin/ffprobe
#FFMPEG_PATH=/usr/bin/ffmpeg

# Analytics

## 1password - search for kesrdkk4jzwknlfqfagngko2re
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_SITE_TAG=


## 1password - search for o3lry5c3tplzg3d5miwtd2qjxa
GOOGLE_SEARCH_CONSOLE_SITE_URL='https://your-search-console-site.se'
